{
  "rewrites": [
    { "source": "/", "destination": "/home-nova.html" },
    { "source": "/agentes", "destination": "/agentes.html" },
    { "source": "/academy", "destination": "/academy.html" },
    { "source": "/cases", "destination": "/cases.html" },
    { "source": "/sobre", "destination": "/sobre.html" },
    { "source": "/plataforma", "destination": "/plataforma.html" },
    { "source": "/faq", "destination": "/faq.html" },
    { "source": "/diagnostico", "destination": "/diagnostico/index.html" },
    { "source": "/cursos/ai-coworker-unimed", "destination": "/cursos/ai-coworker-unimed/index.html" },
    { "source": "/cursos/ia-no-sistema-unimed", "destination": "/cursos/ia-no-sistema-unimed/index.html" }
  ],
  "headers": [
    {
      "source": "/sitemap.xml",
      "headers": [
        { "key": "Content-Type", "value": "application/xml; charset=utf-8" },
        { "key": "Cache-Control", "value": "public, max-age=3600" }
      ]
    },
    {
      "source": "/robots.txt",
      "headers": [
        { "key": "Content-Type", "value": "text/plain; charset=utf-8" },
        { "key": "Cache-Control", "value": "public, max-age=3600" }
      ]
    },
    {
      "source": "/(.*)",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=3600" },
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "X-Frame-Options", "value": "DENY" },
        { "key": "Referrer-Policy", "value": "strict-origin-when-cross-origin" }
      ]
    }
  ]
}
